# Copy to backend/.env and fill in. Never commit .env.

# Comma-separated frontend origins for CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Anthropic (server-side only)
ANTHROPIC_API_KEY=
TUTOR_MODEL=claude-sonnet-5-5
GRADER_MODEL=claude-fable-5-2

# Persistence. Leave empty to use SQLite at backend/cognit.db.
# Supabase: postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres  (then: pip install "psycopg[binary]")
DATABASE_URL=

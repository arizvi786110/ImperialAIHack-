# Copy to backend/.env and fill in. Never commit .env.

# Comma-separated frontend origins for CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Anthropic (server-side only)
ANTHROPIC_API_KEY=
TUTOR_MODEL=claude-sonnet-5-5
GRADER_MODEL=claude-fable-5-2

# Persistence (A2). Leave empty for in-memory; e.g. sqlite:///./cognit.db or a Supabase Postgres URL
DATABASE_URL=

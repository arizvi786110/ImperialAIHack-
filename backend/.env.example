# Copy to backend/.env and fill in. NEVER commit .env (it is gitignored).
# Never paste the API key into code, Discord, screenshots or the frontend.

# Comma-separated frontend origins for CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Persistence. Leave empty to use SQLite at backend/cognit.db.
# Supabase: postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres  (then: pip install "psycopg[binary]")
DATABASE_URL=

# --- AI services (read by cognit_ai; server-side only) ---
ANTHROPIC_API_KEY=
# false = no API calls; tutor/grader use safe deterministic fallbacks
COGNIT_AI_ENABLED=true
COGNIT_AI_TIMEOUT=12
COGNIT_TUTOR_MODEL=claude-sonnet-5-5
COGNIT_GRADER_MODEL=claude-fable-5-2
